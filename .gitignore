# сборка
*.exe
*.pdb
*.obj

# логи автотеста. Журнал пишется рядом с selftest.exe, то есть в tests/, но
# правило без пути закрывает и прежние копии, оставшиеся от запусков из корня.
selftest-log.txt
tests/selftest.exe

# мусор редакторов и системы
.vs/
*.user
*.suo
Thumbs.db
desktop.ini

# нативная часть: результаты сборки и пакеты
*.dll
native/packages/
native/nuget.exe

# установщик: скачиваемый набор WiX и результат сборки
installer/wix/
installer/obj/
installer/LICENSE.rtf
*.msi
*.wixpdb
installer/sign.thumbprint

# описание выпуска, собранное сборщиком из CHANGELOG.md и CHANGELOG.en.md
release-body.md

# Приватное лежит в Core Crew (соседний репозиторий, ..\CoreCrew\projects\DIIISPL),
# а сюда приходит ссылками: папки — соединением, файлы — жёсткой ссылкой (настоящие
# символьные на Windows требуют особых прав). Игнорируются именно ссылки, иначе git
# видел бы одно и то же дважды и предлагал добавить содержимое приватного
# репозитория в открытый. Ставит и чинит их Scripts\link-core-crew.cmd.
#
# До 05.09.2026 приватное лежало подмодулем .backstage; подмодуля больше нет.
#
# Косые черты на конце здесь безопасны, в отличие от репозитория с настоящими
# символьными ссылками: соединение git считает папкой, а жёсткую ссылку — обычным
# файлом, так что ни то, ни другое из-под этих правил не выскакивает.
/CLAUDE.md
/ARCHITECTURE.md
/VERSIONING.md
/.claude/
/plugins/
/.claude-plugin/

# сертификат подписи — только на машине владельца ключа
installer/*.pfx
installer/*.cer

# номер сборки: создаётся build.cmd при каждой сборке
/BuildInfo.g.cs

# снимок последнего прогона: перечень мониторов конкретной машины
tests/last-run.txt

# канал последней сборки: создаётся build.cmd, нужен только установщику
/.channel
