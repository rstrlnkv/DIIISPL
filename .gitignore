# сборка
*.exe
*.pdb
*.obj

# логи автотеста
tests/selftest-log.txt

# мусор редакторов и системы
.vs/
*.user
*.suo
Thumbs.db
desktop.ini

# нативная часть: результаты сборки и пакеты
*.dll
native/packages/
native/nuget.exe

# установщик: скачиваемый набор WiX и результат сборки
installer/wix/
installer/obj/
installer/LICENSE.rtf
*.msi
*.wixpdb
installer/sign.thumbprint

# Приватное лежит в подмодуле .backstage, а сюда приходит ссылками: папки —
# соединением, файлы — жёсткой ссылкой (настоящие символьные на Windows требуют
# особых прав). Сам .backstage не игнорируется — он и есть подмодуль; игнорируются
# только ссылки. Иначе git видел бы одно и то же дважды и предлагал добавить
# содержимое приватного репозитория в открытый.
#
# Косые черты на конце здесь безопасны, в отличие от репозитория с настоящими
# символьными ссылками: соединение git считает папкой, а жёсткую ссылку — обычным
# файлом, так что ни то, ни другое из-под этих правил не выскакивает.
/CLAUDE.md
/ARCHITECTURE.md
/VERSIONING.md
/docs
/.claude/
/plugins/
/.claude-plugin/

# сертификат подписи — только на машине владельца ключа
installer/*.pfx
installer/*.cer

# номер сборки: создаётся build.cmd при каждой сборке
/BuildInfo.g.cs
