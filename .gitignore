# сборка
*.exe
*.pdb
*.obj

# логи автотеста
tests/selftest-log.txt

# мусор редакторов и системы
.vs/
*.user
*.suo
Thumbs.db
desktop.ini

# нативная часть: результаты сборки и пакеты
*.dll
native/packages/
native/nuget.exe

# установщик: скачиваемый набор WiX и результат сборки
installer/wix/
installer/obj/
installer/LICENSE.rtf
*.msi
*.wixpdb
installer/sign.thumbprint

# приватное: лежит в подмодуле .backstage, а сюда приходит символьными ссылками.
# Сам .backstage не игнорируется — он и есть подмодуль; игнорируются только ссылки,
# иначе git видел бы одно и то же дважды и предлагал добавить содержимое в открытый
# репозиторий. Косые черты на конце важны: без них git считает путь файлом и
# перестаёт замечать, что папки больше нет.
/CLAUDE.md
/.claude/
/docs

# сертификат подписи — только на машине владельца ключа
installer/*.pfx
installer/*.cer
