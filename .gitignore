# build
*.exe
*.pdb
*.obj

# autotest logs. The log is written next to selftest.exe, that is in tests/, but
# a rule without a path also covers older copies left from runs in the root.
selftest-log.txt
tests/selftest.exe

# editor and system junk
.vs/
*.user
*.suo
Thumbs.db
desktop.ini

# native part: build output and packages
*.dll
native/packages/
native/nuget.exe

# installer: downloaded WiX toolset and build output
installer/wix/
installer/obj/
installer/LICENSE.rtf
*.msi
*.wixpdb
installer/sign.thumbprint

# release notes, assembled by the builder from CHANGELOG.md and CHANGELOG.ru.md
release-body.md

# local tooling folders (untracked, not part of the product)
/plugins/
/.claude-plugin/

# signing certificate: only on the key owner's machine
installer/*.pfx
installer/*.cer

# build number: created by build.cmd on every build
/src/BuildInfo.g.cs

# snapshot of the last run: the monitor list of a specific machine
tests/last-run.txt

# channel of the last build: created by build.cmd, needed only by the installer
/.channel
# corecrew: internal Claude files and secrets stay out of this repo
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.claude/
docs/superpowers/
.env
.env.*
!.env.example
!.env.sample
!.env.template
