<?xml version="1.0" encoding="utf-8"?>
<!--
  DIIISPL — monitor layout manager for Windows.
  Copyright (C) 2026 r.strlnkv
  Free software under the GNU General Public License v3 or later; see LICENSE.

  The installer. Built by installer\build-msi.cmd.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <!-- The version comes from the build through -dVersion (build-msi.cmd always passes
       it); there is no fallback, a stored copy would drift from AssemblyInfo.cs. -->
  <?ifndef Version ?>
  <?error candle needs -dVersion=X.Y.Z; run installer\build-msi.cmd ?>
  <?endif ?>

  <!--
       The product code comes from outside, not as an asterisk. The package is built
       twice, once per language, and a translation embeds as the difference between
       the builds. With an asterisk each build would get its own code, and a "translation"
       would first of all replace the whole product. build-msi.cmd issues a new code
       for every build, and explains there why it is new and not derived
       from the version number.
  -->
  <?ifndef ProductCode ?>
  <?define ProductCode = "*" ?>
  <?endif ?>

  <Product Id="$(var.ProductCode)"
           Name="DIIISPL"
           Language="!(loc.Language)"
           Version="$(var.Version)"
           Manufacturer="Rostislav Strelnikov"
           UpgradeCode="0E2BE8B0-FF5F-4590-9D0A-F7D9E6C6BDC1">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="!(loc.PackageDescription)"
             Comments="!(loc.PackageComments)"
             Languages="!(loc.Language)"
             SummaryCodepage="!(loc.SummaryCodepage)" />

    <MediaTemplate EmbedCab="yes" />

    <!-- A new version replaces the old one rather than sitting next to it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="!(loc.DowngradeError)" />

    <!--
      The program lives in the tray and keeps a library open inside Explorer.
      If it is not closed, the files stay locked and the install will require a reboot.
    -->
    <util:CloseApplication Id="CloseDIIISPL"
                           Target="DIIISPL.exe"
                           CloseMessage="yes"
                           TerminateProcess="1"
                           RebootPrompt="no" />

    <Icon Id="DIIISPL.ico" SourceFile="$(var.SourceDir)\src\DIIISPL.ico" />
    <Property Id="ARPPRODUCTICON" Value="DIIISPL.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/rstrlnkv/DIIISPL" />

    <!-- Otherwise the installed programs list shows empty location and size. -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <!--
      An upgrade must land where the previous version was, and must not
      bring back a shortcut that was declined.

      An upgrade from the program window runs with /qb, that is, without a single
      question. While the installer remembered nothing, this meant: a program
      installed in D:\Programs was silently moved by the upgrade to
      C:\Program Files, and a Start menu shortcut appeared that the user did not
      ask for. Autostart broke as well, since it holds the path to the old file.

      The folder is remembered by a registry entry, but the registry need not be asked about the shortcut:
      its component keeps its key there anyway, and the key being present means
      "the shortcut was installed".
    -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PrevInstallFolder" Root="HKLM" Key="Software\DIIISPL"
                      Name="InstallFolder" Type="directory" Win64="yes" />
    </Property>

    <Property Id="PREVSHORTCUT">
      <RegistrySearch Id="PrevShortcut" Root="HKLM" Key="Software\DIIISPL"
                      Name="StartMenuShortcut" Type="raw" Win64="yes" />
    </Property>

    <!--
      SHORTCUTCHOSEN is set by the dialog asking about the shortcut. While it was missing, the user's
      answer was overwritten: the action is in both sequences, and the
      second time it runs after the dialogs.
    -->
    <Property Id="SHORTCUTCHOSEN" Secure="yes" />

    <!-- Marker "taking the Modify path": the dialogs use it to know where the
         Back button goes. Set and cleared in DIIISPLUI.wxs. -->
    <Property Id="DIIISPLCHANGING" Secure="yes" />
    <SetProperty Id="INSTALLSHORTCUT" Value="0" After="AppSearch" Sequence="both">
      (WIX_UPGRADE_DETECTED OR Installed) AND NOT PREVSHORTCUT AND NOT SHORTCUTCHOSEN
    </SetProperty>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="DIIISPL" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainProgram" Guid="*" Win64="yes">
        <File Id="DIIISPL.exe" Source="$(var.BinDir)\DIIISPL.exe" KeyPath="yes" />
      </Component>

      <!--
        The taskbar styling library is only in Dev builds. The stable one has no
        taskbar code at all, and there is no point putting next to the program a library that
        is loaded into Explorer and stays there: what is not in the package
        cannot go off.
      -->
      <?if $(var.Channel) = "dev" ?>
      <Component Id="TaskbarLibrary" Guid="*" Win64="yes">
        <File Id="DIIISPL.ExplorerTAP.dll" Source="$(var.BinDir)\DIIISPL.ExplorerTAP.dll" KeyPath="yes" />
      </Component>
      <?endif ?>

      <!-- One component per file: neither has a version, and such files do not combine into one. -->
      <Component Id="License" Guid="*" Win64="yes">
        <File Id="LICENSE.txt" Source="$(var.SourceDir)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
      </Component>

      <Component Id="Readme" Guid="*" Win64="yes">
        <File Id="README.md" Source="$(var.SourceDir)\README.md" KeyPath="yes" />
      </Component>

      <!-- Where it was installed. Read at the next upgrade, see RegistrySearch above. -->
      <Component Id="InstallState" Guid="*" Win64="yes">
        <RegistryValue Root="HKLM" Key="Software\DIIISPL" Name="InstallFolder"
                       Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!--
      The shortcut is a separate component, not an add-on to the program file: otherwise it
      cannot be declined, since a component is installed whole. The key here is a registry entry,
      because the shortcut itself cannot be a key.
    -->
    <Property Id="INSTALLSHORTCUT" Value="1" Secure="yes" />

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*" Win64="yes">
        <!--
          Comparing with a value is required: a bare property name is true for any
          non-empty string, and "0" is also a non-empty string, so the shortcut would be created
          even with the checkbox cleared.
        -->
        <Condition>INSTALLSHORTCUT = "1"</Condition>
        <Shortcut Id="DIIISPLShortcut"
                  Name="DIIISPL"
                  Description="!(loc.ShortcutDescription)"
                  Target="[INSTALLFOLDER]DIIISPL.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="DIIISPL.ico" />
        <RegistryValue Root="HKLM" Key="Software\DIIISPL" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="!(loc.FeatureTitle)" Level="1" Absent="disallow"
             ConfigurableDirectory="INSTALLFOLDER"
             Description="!(loc.FeatureDescription)">
      <ComponentRef Id="MainProgram" />
      <?if $(var.Channel) = "dev" ?>
      <ComponentRef Id="TaskbarLibrary" />
      <?endif ?>
      <ComponentRef Id="License" />
      <ComponentRef Id="Readme" />
      <ComponentRef Id="InstallState" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Offer to launch right after install. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchCheckbox)" />
    <Property Id="WixShellExecTarget" Value="[#DIIISPL.exe]" />
    <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec"
                  Impersonate="yes" Return="ignore" />

    <!--
      Return the program to the tray after an upgrade from within.

      The upgrade runs with /qb: there is no last dialog with a Finish button, and the launch
      hung only on it. The result: the user pressed "Update", the installer
      closed the running copy, replaced the files, and that was all. The tray icon vanished, the window
      did not come back, nothing was said; from outside this looks like "the upgrade
      crashed the program".

      The property is passed by Updater itself, so a regular manual install does not
      take this path: there the checkbox in the last dialog still handles the launch.
      The action is immediate and does not wait: it runs as the user who
      updated, and there is no need to keep the installer open while the program lives.
    -->
    <Property Id="DIIISPLRELAUNCH" Secure="yes" />
    <SetProperty Id="RelaunchExe" Value="[INSTALLFOLDER]DIIISPL.exe"
                 Before="RelaunchInTray" Sequence="execute" />
    <CustomAction Id="RelaunchInTray" Property="RelaunchExe" ExeCommand="/tray"
                  Execute="immediate" Return="asyncNoWait" />

    <!--
      Remove the autostart entry when the program is uninstalled.

      Autostart is enabled by the program itself, from the tray icon menu, and
      the entry goes into the user's hive. The package installs machine-wide,
      does not know about this entry, and after uninstall it was left hanging: Windows
      tried at every sign-in to launch a file that no longer exists.

      The action must be immediate. Deferred ones run during a machine-wide install
      as the system, and HKCU there is the hive of the system account, not of the one
      uninstalling; the user's entry cannot be reached that way. An immediate one runs in the
      user's own hive.

      Return="ignore" is required: if autostart was never enabled, reg returns "no
      such value", and the uninstall must not stop on that.
    -->
    <SetProperty Id="DIIISPLREGEXE" Value="[System64Folder]reg.exe"
                 Before="CleanAutoStart" Sequence="execute" />
    <CustomAction Id="CleanAutoStart" Property="DIIISPLREGEXE"
                  ExeCommand="delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v DIIISPL /f"
                  Execute="immediate" Return="ignore" />

    <InstallExecuteSequence>
      <!--
        NOT UPGRADINGPRODUCTCODE is required. An upgrade works so that the new
        package runs the uninstall of the old one, with REMOVE="ALL" in its own
        sequence. Without this condition every upgrade would erase the
        autostart entry: the program would return to the tray, but at the next
        Windows sign-in it would no longer start, and the checkbox would be cleared. That is,
        the upgrade itself would turn off exactly the setting we are fixing here.
      -->
      <Custom Action="CleanAutoStart" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RelaunchInTray" After="InstallFinalize">DIIISPLRELAUNCH="1" AND NOT REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

    <!-- Own dialog set: folder choice plus a separate shortcut question, see DIIISPLUI.wxs. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!-- Own images instead of the standard ones from the WiX set. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.ArtDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.ArtDir)\dialog.bmp" />
    <UIRef Id="WixUI_DIIISPL" />

    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed
      </Publish>
    </UI>

  </Product>
</Wix>
