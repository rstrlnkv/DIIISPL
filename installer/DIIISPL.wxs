<?xml version="1.0" encoding="utf-8"?>
<!--
  DIIISPL — менеджер раскладок мониторов для Windows.
  Copyright (C) 2026 r.strlnkv
  Свободная программа под GNU General Public License v3 или новее; см. LICENSE.

  Установщик. Собирается installer\build-msi.cmd.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <!-- Версию задаёт сборка через -dVersion; значение ниже — только для запуска
       candle вручную. Пока его не было, номер стоял здесь намертво: имя файла
       менялось по тегу, а ProductVersion внутри пакета оставался прежним —
       и «Программы и компоненты» показывали бы одну версию вечно. -->
  <?ifndef Version ?>
  <?define Version = "0.1.0" ?>
  <?endif ?>

  <!--
       Код продукта приходит извне, а не выписан звёздочкой. Пакет собирается
       дважды — по разу на язык, — и перевод внутрь встаёт разницей между этими
       сборками. Со звёздочкой каждая сборка получала бы свой код, и «перевод»
       первым делом подменял бы продукт целиком. Новый код на каждую сборку
       выдаёт build-msi.cmd — там же и объяснено, почему новый, а не выведенный
       из номера версии.
  -->
  <?ifndef ProductCode ?>
  <?define ProductCode = "*" ?>
  <?endif ?>

  <Product Id="$(var.ProductCode)"
           Name="DIIISPL"
           Language="!(loc.Language)"
           Version="$(var.Version)"
           Manufacturer="Rostislav Strelnikov"
           UpgradeCode="0E2BE8B0-FF5F-4590-9D0A-F7D9E6C6BDC1">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="!(loc.PackageDescription)"
             Comments="!(loc.PackageComments)"
             Languages="!(loc.Language)"
             SummaryCodepage="!(loc.SummaryCodepage)" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Новая версия заменяет прежнюю, а не встаёт рядом с ней. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="!(loc.DowngradeError)" />

    <!--
      Программа живёт в трее и держит открытой библиотеку внутри проводника.
      Если её не закрыть, файлы окажутся занятыми и установка потребует перезагрузки.
    -->
    <util:CloseApplication Id="CloseDIIISPL"
                           Target="DIIISPL.exe"
                           CloseMessage="yes"
                           TerminateProcess="1"
                           RebootPrompt="no" />

    <Icon Id="DIIISPL.ico" SourceFile="$(var.SourceDir)\DIIISPL.ico" />
    <Property Id="ARPPRODUCTICON" Value="DIIISPL.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/rstrlnkv/DIIISPL" />

    <!-- Иначе в списке установленных программ расположение и размер остаются пустыми. -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <!--
      Обновление обязано встать туда же, где стояла прежняя версия, и не
      возвращать ярлык, от которого отказались.

      Обновление из окна программы идёт с ключом /qb, то есть без единого
      вопроса. Пока установщик ничего не помнил, это значило: программу,
      поставленную в D:\Programs, обновление молча переносило в
      C:\Program Files, а в меню «Пуск» появлялся ярлык, которого человек не
      просил. Заодно ломался автозапуск — в нём записан путь к прежнему файлу.

      Папку помним записью в реестре, а про ярлык спрашивать реестр не нужно:
      у его компонента ключ и так лежит там, и само наличие ключа означает
      «ярлык ставили».
    -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PrevInstallFolder" Root="HKLM" Key="Software\DIIISPL"
                      Name="InstallFolder" Type="directory" Win64="yes" />
    </Property>

    <Property Id="PREVSHORTCUT">
      <RegistrySearch Id="PrevShortcut" Root="HKLM" Key="Software\DIIISPL"
                      Name="StartMenuShortcut" Type="raw" Win64="yes" />
    </Property>

    <!--
      SHORTCUTCHOSEN ставит окно с вопросом про ярлык. Пока его не было, ответ
      человека затирался: действие стоит в обеих последовательностях, и во
      второй раз выполняется уже после окон.
    -->
    <Property Id="SHORTCUTCHOSEN" Secure="yes" />
    <SetProperty Id="INSTALLSHORTCUT" Value="0" After="AppSearch" Sequence="both">
      (WIX_UPGRADE_DETECTED OR Installed) AND NOT PREVSHORTCUT AND NOT SHORTCUTCHOSEN
    </SetProperty>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="DIIISPL" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainProgram" Guid="*" Win64="yes">
        <File Id="DIIISPL.exe" Source="$(var.BinDir)\DIIISPL.exe" KeyPath="yes" />
      </Component>

      <!--
        Библиотека оформления панели задач — только в сборках Dev. В стабильной
        панели задач нет вовсе, и класть рядом с программой библиотеку, которая
        загружается внутрь проводника и остаётся там жить, незачем: чего в пакете
        нет, то не выстрелит.
      -->
      <?if $(var.Channel) = "dev" ?>
      <Component Id="TaskbarLibrary" Guid="*" Win64="yes">
        <File Id="DIIISPL.ExplorerTAP.dll" Source="$(var.BinDir)\DIIISPL.ExplorerTAP.dll" KeyPath="yes" />
      </Component>
      <?endif ?>

      <!-- По компоненту на файл: у обоих нет версии, а такие в один не складываются. -->
      <Component Id="License" Guid="*" Win64="yes">
        <File Id="LICENSE.txt" Source="$(var.SourceDir)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
      </Component>

      <Component Id="Readme" Guid="*" Win64="yes">
        <File Id="README.md" Source="$(var.SourceDir)\README.md" KeyPath="yes" />
      </Component>

      <!-- Куда поставили. Читается при следующем обновлении, см. RegistrySearch выше. -->
      <Component Id="InstallState" Guid="*" Win64="yes">
        <RegistryValue Root="HKLM" Key="Software\DIIISPL" Name="InstallFolder"
                       Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!--
      Ярлык отдельным компонентом, а не довеском к файлу программы: иначе от него
      нельзя отказаться — компонент ставится целиком. Ключом здесь запись в реестре,
      потому что сам ярлык ключом быть не может.
    -->
    <Property Id="INSTALLSHORTCUT" Value="1" Secure="yes" />

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*" Win64="yes">
        <!--
          Сравнение со значением обязательно: голое имя свойства истинно при любой
          непустой строке, а «0» — тоже непустая строка, и ярлык создавался бы
          даже при снятом флажке.
        -->
        <Condition>INSTALLSHORTCUT = "1"</Condition>
        <Shortcut Id="DIIISPLShortcut"
                  Name="DIIISPL"
                  Description="!(loc.ShortcutDescription)"
                  Target="[INSTALLFOLDER]DIIISPL.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="DIIISPL.ico" />
        <RegistryValue Root="HKLM" Key="Software\DIIISPL" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="!(loc.FeatureTitle)" Level="1" Absent="disallow"
             ConfigurableDirectory="INSTALLFOLDER"
             Description="!(loc.FeatureDescription)">
      <ComponentRef Id="MainProgram" />
      <?if $(var.Channel) = "dev" ?>
      <ComponentRef Id="TaskbarLibrary" />
      <?endif ?>
      <ComponentRef Id="License" />
      <ComponentRef Id="Readme" />
      <ComponentRef Id="InstallState" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Предложить запуск сразу после установки. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchCheckbox)" />
    <Property Id="WixShellExecTarget" Value="[#DIIISPL.exe]" />
    <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec"
                  Impersonate="yes" Return="ignore" />

    <!--
      Вернуть программу в трей после обновления изнутри.

      Обновление идёт с /qb: последнего окна с кнопкой «Готово» нет, а запуск
      висел только на ней. Получалось так: человек нажал «Обновить», установщик
      закрыл работающую копию, заменил файлы — и всё. Значок из трея исчез, окно
      не вернулось, ничего не сказано; со стороны это выглядит как «обновление
      уронило программу».

      Свойство передаёт сам Updater, поэтому обычная установка руками этим путём
      не идёт — там за запуск по-прежнему отвечает галочка в последнем окне.
      Действие немедленное и без ожидания: оно выполняется от имени того, кто
      обновлялся, а держать установщик открытым, пока живёт программа, незачем.
    -->
    <Property Id="DIIISPLRELAUNCH" Secure="yes" />
    <SetProperty Id="RelaunchExe" Value="[INSTALLFOLDER]DIIISPL.exe"
                 Before="RelaunchInTray" Sequence="execute" />
    <CustomAction Id="RelaunchInTray" Property="RelaunchExe" ExeCommand="/tray"
                  Execute="immediate" Return="asyncNoWait" />

    <!--
      Убрать запись автозапуска при удалении программы.

      Автозапуск включает сама программа — пунктом в меню значка в трее, — и
      запись при этом ложится в ветку пользователя. Пакет ставится на всю машину,
      про эту запись не знает, и после удаления она оставалась висеть: Windows
      при каждом входе пыталась запустить файл, которого больше нет.

      Действие именно немедленное. Отложенные при установке на машину выполняются
      от имени системы, и HKCU там — ветка системной учётной записи, а не того,
      кто удаляет; запись пользователя так не достать. Немедленное идёт в его
      собственной ветке.

      Return="ignore" обязателен: если автозапуск не включали, reg вернёт «нет
      такого значения», и удаление пакета не должно на этом останавливаться.
    -->
    <SetProperty Id="DIIISPLREGEXE" Value="[System64Folder]reg.exe"
                 Before="CleanAutoStart" Sequence="execute" />
    <CustomAction Id="CleanAutoStart" Property="DIIISPLREGEXE"
                  ExeCommand="delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v DIIISPL /f"
                  Execute="immediate" Return="ignore" />

    <InstallExecuteSequence>
      <!--
        NOT UPGRADINGPRODUCTCODE обязательно. Обновление устроено так, что новый
        пакет прогоняет удаление старого — с REMOVE="ALL" в его собственной
        последовательности. Без этой оговорки каждое обновление стирало бы
        запись автозапуска: программа возвращалась бы в трей, но при следующем
        входе в Windows уже не запускалась, и галочка стояла бы снятой. То есть
        обновление само выключало бы ровно ту настройку, которую мы тут чиним.
      -->
      <Custom Action="CleanAutoStart" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RelaunchInTray" After="InstallFinalize">DIIISPLRELAUNCH="1" AND NOT REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

    <!-- Свой набор окон: выбор папки плюс отдельный вопрос про ярлык, см. DIIISPLUI.wxs. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!-- Свои картинки вместо стандартных из набора WiX. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.ArtDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.ArtDir)\dialog.bmp" />
    <UIRef Id="WixUI_DIIISPL" />

    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed
      </Publish>
    </UI>

  </Product>
</Wix>
